    <decisions>
        <name>Did_Name_Change</name>
        <label>Did Name Change?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Name_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Name</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Name_Audit</targetReference>
            </connector>
            <label>Name Changed</label>
        </rules>
        <rules>
            <name>IsActive_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Active__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Active__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_IsActive_Audit</targetReference>
            </connector>
            <label>IsActive Changed</label>
        </rules>
    </decisions>
